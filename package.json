{
  "name": "smartcontrol",
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "type": "commonjs",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "frontend": "npm run dev -w frontend",
    "backend": "npm run dev -w backend",
    "electron": "electron .",
    "dev": "concurrently --kill-others \"npm run frontend\" \"npm run backend\" \"npm run electron\"",
    "build:all": "npm run build -w frontend && npm run build -w backend",
    "dist": "npm run build:all && electron-builder"
  },
  "build": {
    "appId": "com.smartcontrol.iot",
    "productName": "SmartControl IoT",
    "win": {
      "target": "nsis"
    },
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "electron/**/*",
      "packages/frontend/dist/**/*",
      "packages/backend/dist/**/*",
      "!packages/backend/src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "packages/backend/src/scripts/dist_bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asar": false
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^40.0.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.3",
    "dotenv": "^17.2.4",
    "fastify": "^5.8.5",
    "mongoose": "^9.5.0",
    "tuyapi": "^7.7.1"
  }
}
